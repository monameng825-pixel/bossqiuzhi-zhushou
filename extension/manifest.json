{
  "manifest_version": 3,
  "name": "求职助手 · 简历岗位智能匹配",
  "version": "1.3.3",
  "description": "在 Boss直聘上实时匹配打分、AI 定制简历、一键发送简历并打招呼；巡岗筛选高匹配岗位。数据只存本地。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.zhipin.com/*",
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "求职助手 · 经历库与看板"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zhipin.com/*"
      ],
      "js": [
        "engine.js",
        "resume_image.js",
        "content.js",
        "patrol.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dashboard.html",
  "web_accessible_resources": [
    {
      "resources": [
        "atoms.sample.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}